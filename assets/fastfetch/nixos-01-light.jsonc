{
  "logo": {
    // 用 fastfetch 自带的 Arch 字符 logo（type=builtin），不再部署图片、也不再
    // 依赖 sixel 图片协议。内置 logo 使用 ANSI cyan（跟随终端调色板）；
    // tmux / SSH / 管道等环境与图形终端表现一致，不会静默回退。
    // 尺寸 37 列 × 19 行；备选 arch2 / arch3 / arch_small（fastfetch --list-logos 可查）。
    // logo 不区分亮/暗，两份 jsonc 这句完全相同。
    // padding 单位是字符，只影响排版：顶部空 2 行、左侧空 3 列。
    "type": "builtin",
    "source": "arch",
    "padding": {
      "top": 2,
      "left": 3,
    },
  },
  "display": {
    "separator": " ",
    // {$1}..{$10}：一条冷色明度渐变，不是彩虹。
    //
    // 为什么不用彩虹：这 10 个常量会被用在约 30 个键名标签上（主机 / 处理器 …），
    // 10 个不同色相铺满一整列文字就是噪声；一条同色族的渐变才读得出“一列”。
    //
    // 色相与彩度与暗色那份**完全一致**：沿用仓库原有的深蓝 → 浅蓝冷色阶，
    // 不再由 logo 推导。亮/暗两份只差**亮度方向**，色族相同 —— 翻软链时不会像换了一套配色。
    //
    // 亮度必须重算，不能照抄暗色那份：Latte 底色 #EFF1F5 上原色阶两端
    // 只有 3.88:1 / 1.85:1，达不到 AA 4.5。这里把 {$1}
    // 压到刚好 4.79:1（L=0.5270），{$10} 再暗 0.0651（与暗色那份的亮度跨度相同，
    // 所以两套渐变的视觉幅度一致），落在 L=0.4619 / 6.19:1。
    //     ${1}  #4468B3  (4.79:1)   H263.4 C0.1248
    //     ${10} #225E84  (6.19:1)   H239.9 C0.0866
    // 中间阶为 OKLCH 插值（逐阶做过 sRGB 色域裁剪，所以色值非严格线性）。
    // 另：状态色（colored number 的 green / yellow / red）保留 Latte 同名色，它们在浅底上
    // 只有 2.96 / 2.31 / 4.80，达不到 AA —— 刻意取舍（语义优先），要改就得用非调色板色。
      "constants": [
      "\u001b[38;2;68;104;179m\u001B[1m", // {$1}  #4468B3  H263.4 C0.125  4.79:1
      "\u001b[38;2;63;103;174m\u001B[1m", // {$2}  #3F67AE  H260.8 C0.121  4.94:1
      "\u001b[38;2;58;102;168m\u001B[1m", // {$3}  #3A66A8  H258.2 C0.116  5.09:1
      "\u001b[38;2;53;102;163m\u001B[1m", // {$4}  #3566A3  H255.5 C0.112  5.19:1
      "\u001b[38;2;49;101;158m\u001B[1m", // {$5}  #31659E  H252.9 C0.108  5.33:1
      "\u001b[38;2;45;100;153m\u001B[1m", // {$6}  #2D6499  H250.3 C0.104  5.47:1
      "\u001b[38;2;41;98;148m\u001B[1m", // {$7}  #296294  H247.7 C0.099  5.68:1
      "\u001b[38;2;38;97;142m\u001B[1m", // {$8}  #26618E  H245.1 C0.095  5.83:1
      "\u001b[38;2;36;96;137m\u001B[1m", // {$9}  #246089  H242.5 C0.091  5.97:1
      "\u001b[38;2;34;94;132m\u001B[1m", // {$10} #225E84  H239.9 C0.087  6.19:1
    ],
    "percent": {
      "type": 9, // 1=number, 2=bar, 3=both, 9=colored number
      // 键名指的是阈值档位而非字面色：green = 低于第一阈值，yellow = 两阈值之间，
      // red = 高于第二阈值。此前分别填的是蓝色/绿色/橙色，读起来很迷惑。
      "color": {
        "green": "#40A02B", // Frappe green
        "yellow": "#DF8E1D", // Frappe yellow
        "red": "#D20F39", // Frappe red
      },
    },
  },
  "modules": [
    // 宽度预算：logo 37 列（内置 Arch 字符图），整行 ≲ 96 列（半屏终端，实测最长 96）。
    // 信息头用中文 —— fastfetch 不会按显示宽度对齐 CJK，空格是手工补到 8 列的。
    // 不再输出版本行与分组标题，只保留字段。
    // 输出前后各留两行空行：前面由 logo.padding.top + 两个 break 生成；
    // 末尾的 3 个 break 抵消 fastfetch 吃掉的最后一个换行后也正好是两行。
    "break",
    "break",
    {
      "type": "host",
      "key": "{$1}   主机    ",
    },
    {
      "type": "cpu",
      "format": "{name}",
      "key": "{$2}   处理器  ",
    },
    {
      "type": "gpu",
      "format": "{name}",
      "key": "{$3} 󰾲  显卡    ",
    },
    {
      "type": "display",
      "format": "{1}x{2} @ {3}Hz",
      "key": "{$4} 󰍹  显示器  ",
    },
    {
      "type": "memory",
      "key": "{$5}   内存    ",
    },
    {
      "type": "swap",
      "key": "{$6} 󰯍  交换    ",
    },
    {
      "type": "disk",
      "key": "{$7}   家目录  ",
      "format": "{size-used} / {size-total} ({size-percentage})",
      "folders": ["/home"],
    },
    {
      "type": "os",
      "key": "{$8}   发行版  ",
      "format": "{name} {version}",
    },
    {
      "type": "kernel",
      "key": "{$9}   内核    ",
    },
    {
      "type": "de",
      "key": "{$10}   桌面    ",
    },
    {
      "type": "lm",
      "key": "{$1} 󰧨  登录    ",
    },
    {
      "type": "wm",
      "key": "{$2}   窗口    ",
    },
    {
      "type": "wmtheme",
      "key": "{$3} 󰉼  主题    ",
    },
    {
      "type": "terminal",
      "key": "{$4}   终端    ",
    },
    {
      "type": "shell",
      "key": "{$5}   Shell   ",
    },
    {
      "type": "font",
      "key": "{$6} 󰛖  字体    ",
      // Qt / GTK2/3/4 用的是同一个字体，只显示 {1}（字体名 + 字号），
      // 不再输出「[Qt], [GTK2/3/4]」的重复列表。
      "format": "{1}",
    },
    {
      "type": "opengl",
      "key": "{$7} 󰆧  OpenGL  ",
    },
    {
      "type": "vulkan",
      "key": "{$8} 󰈸  Vulkan  ",
    },
    {
      "key": "{$9}   系统年龄",
      "type": "disk",
      "folders": "/",
      "format": "{create-time:10} ({days} days)",
    },
    {
      "type": "bluetooth",
      "key": "{$10} 󰂱  蓝牙    ",
      "format": "{1} - {4}",
    },
    {
      "type": "localip",
      "key": "{$1} 󰩟  局域网  ",
      "format": "{1}",
      "showMac": false,
    },
    "break",
    "break",
    "break",
  ],
}
