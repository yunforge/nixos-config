// 启动时生成进程
// polkit 认证代理（二进制由 nixos 模块包成同名 wrapper 放入 PATH）
spawn-at-startup "polkit-gnome-authentication-agent-1"
// noctalia shell
spawn-at-startup "noctalia"
// 输入法
spawn-at-startup "fcitx5"
// XWayland 的 Xft.dpi：fcitx5 在 X11 客户端上只读该资源来决定候选窗缩放，
// 缺失时 X11 候选窗会停在 1.0x（workaround，见 modules/nixos/desktop/niri/default.nix）
spawn-at-startup "xwayland-xft-dpi"

// niri 启动时不自动展示快捷键叠加层
hotkey-overlay {
    skip-at-startup
}
