// 窗口规则
// 全局：默认平铺，圆角修饰
window-rule {
    // ── 圆角：当前 8（Omarchy 档）──────────────────────────────────────────
    //
    // 2026-10-02 从 24 降到 8。24 那版照 macOS 的 concentricity 阶梯取、与
    // MacTahoe-Dark 主题自己的窗口档 1:1，看下来太圆；Omarchy（Arch + Hyprland）
    // 默认是直角（decoration.rounding = 0），手册给出的圆角档是 8。
    //
    // 主题自己的档位（gtk-4.0/gtk.css，2026-10-01 对照代码核过）：
    //
    //     window.csd / floating/bottom-sheet  24   ← 已不再沿用
    //     notebook.frame 19 / .sidebar-pane 18 / notebook > header 16 / tab 14
    //     popover / menu / osd                12   ← 独立弹层
    //     按钮 / 输入框                         6
    //     药丸                              9999
    //
    // ⚠ 未解：主题内层仍有 19/18/16/14/12，比窗口的 8 更圆 —— 正是
    // docs/themes.md「内层不能比外层更圆」那条的反面。压平内层要用
    // gtk.gtk{3,4}.extraCss 覆盖 5 个以上选择器，还没做，先看视觉能否接受。
    //
    // 注：输入法候选窗的圆角烘在上游 SVG 里（39×39, rx=8），由 fcitx5.nix 的
    // runCommand 改成 12、九宫格 Margin 从 10 抬到 14（rx 必须 ≤ Margin，否则角片会被切）。
    //
    // 阴影由合成器按本值绘制（wm/default.nix 的 shadow 块）；clip-to-geometry
    // 会连 CSD 自绘阴影一起裁掉。
    geometry-corner-radius 8
    clip-to-geometry true
    draw-border-with-background false
    open-maximized false
    open-floating false            // 默认平铺
}

// 允许 Noctalia 执行通知操作和激活窗口
debug {
    honor-xdg-activation-with-invalid-serial
}

// ═══════════════════════════════════════════════
// 最大化窗口
// ═══════════════════════════════════════════════

// WinApps — Windows 虚拟机整机会话（FreeRDP RemoteApp）
//
// app-id 不是 freerdp / sdl-freerdp3，而是由 WinApps 启动整机会话时传给 FreeRDP 的
// /wm-class:"Microsoft Windows"（见上游 src/bin/winapps：整机会话用固定值
// "Microsoft Windows"，单应用 RemoteApp 用该应用全名）—— SDL3 客户端把 wm-class
// 直接当作 Wayland 的 app_id，故实测 app-id 就是 "Microsoft Windows"。
//
// 整机会话是一整套自带任务栏的远程桌面，按普通窗口半屏打开没有意义；该会话带
// +dynamic-resolution，最大化后远端会跟着改分辨率。
//
// 只匹配整机会话：单应用 RemoteApp 窗口的 wm-class 是各自应用全名（如
// "Microsoft Word"），不落在本规则内、仍按普通窗口平铺；若想让某个应用也
// 打开即最大化，按它的全名另加一条同款规则即可。
window-rule {
    match app-id="^Microsoft Windows$"
    open-maximized true
}

// VS Code — 主窗口（最大化）
window-rule {
    match app-id="(?i)^code"
    open-maximized true
}

// Logisim Evolution — 逻辑电路模拟
window-rule {
    match app-id="com-cburch-logisim-Main"
    open-maximized true
}

// brave — 浏览器
window-rule {
    match app-id="brave"
    open-maximized true
}

// Zotero — 文献管理
window-rule {
    match app-id="(?i)zotero"
    open-maximized true
}

// Steam — 商店 / 库
// app-id 取 X11 的 WM_CLASS（steam 走 XWayland）；若实际不是这个，用
// `niri msg windows` 看真实 app-id 再改。
window-rule {
    match app-id="(?i)^steam$"
    open-maximized true
}

// babry — 截图编辑器（GUI 智能选区 + 标注）
//
// 上游明确要求（README「niri 配置」）：编辑器要以全屏显示，未配置时按普通
// 窗口平铺。这里给上「打开即全屏 + 夺取焦点」两条 —— babry 是「按快捷键后
// 立刻悬停选点」的交互，窗口不起焦点就会选到上一次的焦点窗口。
// app-id 就是 "babry"（上游未设 desktopName，取进程名）。
window-rule {
    match app-id=r#"^babry$"#
    open-fullscreen true
    open-focused true
}


// ═══════════════════════════════════════════════
// 浮动窗口（统一尺寸，居中）
// ═══════════════════════════════════════════════
//
// 2026-10-06：删掉原来的六档尺寸表（sidebar/tool/chat/settings/content）与逐应用
// 分档，改为所有浮动窗口共用一个尺寸。
//
// 2026-10-29：尺寸从「工作区比例 0.50×0.60」改为固定 900×623（比例 13:9，
// 取自 Omarchy `Super + O` 的 1300×900）。取舍与算法见下面「尺寸」段的说明。
//
// 尺寸只写在一个地方：niri 没有「全局浮动尺寸」选项，尺寸只能落在 window-rule 上；
// 但一条规则里可以写多个 match（彼此是 OR —— 见 niri wiki「Window Rules」：
// is_active / title / app-id 多条 `match` 之间是「或」）。于是下面把 19 个 app-id
// （共 20 个窗口：Pot 的翻译窗与偏好面板各一个）堆进**一条规则**，几何只声明一次
// —— 比原先逐 app 各写一遍尺寸少十几处重复。
//
// 居中：niri 对浮动窗口**本来就默认居中**（floating.rs 的 add_tile_at 用
// center_preferring_top_left_in_area(working_area) 兜底）。所以「居中且尺寸合适」
// 只需要一处尺寸 + 不写 default-floating-position —— 后者一旦写出就会覆盖居中、
// 把窗口推到屏幕角上。原 Pot 那条 relative-to="top-right" 正是这么做的，现已删除。
//
// 尺寸：900×623 逻辑像素，比例 13:9（取自 Omarchy 的 `Super + O`）。
//
// Omarchy 那边 `Super + O` = 「Pop window out (float & pin)」，实现在
// bin/omarchy-hyprland-window-pop：脚本默认 width=1300 height=900，
// 即 `hyprctl dispatch resizeactive exact 1300 900` 后 `centerwindow`，
// 再 `pin` 钉住（浮动但不平铺）。故取其宽高比 1300:900 ≈ 13:9。
//
// 为什么用 fixed 绝对值而不是 proportion：niri 的 default-column-width 与
// default-window-height 是**两个各自独立**按工作区边长算的比例，无法表达
// 「宽高比」——同一个 (0.50, 0.60) 在 2544×1424 的 4K 工作区得 1272×854
// （比 1.489），在 1264×704 的 1080p 工作区得 632×422（比 1.496），两块屏
// 的比例都随屏幕长宽比漂移。而窗口规则无法按输出分别声明（open-on-output
// 一条规则只对一个输出），所以 proportion 方案做不到双屏统一 13:9。
//
// 900×623 是能在**两块屏都放得下**的 13:9 尺寸：1080p 屏工作区仅
// 1264×704（900 占 71% 宽、623 占 88% 高），4K 屏工作区 2544×1424
// （占 35% 宽、44% 高）。比 Omarchy 的 1300×900 小 —— 那边是给 1920×1080
// 屏设计的，本机 1080p 屏的逻辑工作区只有 1264×704，照搬会放不下。
//
// 客户端仍可自选尺寸（niri 文档：the window itself always has a final say
// in its size）—— 规则只决定初始 configure 的尺寸。实测：disktree 严格按
// 900×623 打开（= 规则值）；但微信主窗口实测是 900×720 —— 宽守住了 900，
// 高被客户端自己选的 720 顶掉（它的 X11 min_size 是 845×858）。试过加
// `max-height 623` 强制钳死，结果 niri 侧与客户端的 min_size 冲突，窗口
// 直接无法映射；`max-width 900` 则无效果（客户端请求的宽本就等于 900）。
// 故此处不加 max-*，宽高比由「客户端配合」决定，规则保证的是初始尺寸。
//
// open-floating 仍逐条写明：全局规则声明了 open-floating false，而本规则要把它翻回
// true。niri 对同一条规则内的多个 match 不做「后覆盖前」——一条规则要么整体命中、
// 要么不命中，所以这里不需要像原来那样为「同 app-id 的第二个窗口」留覆盖规则
// （Pot 的翻译窗与 Config 面板原先正是两条同 app-id 的规则）。
window-rule {
    // 输入法设置 / 图床上传 / 系统监控 / 看图 / 传文件
    match app-id="(?i)fcitx5"
    match app-id="(?i)picgo"
    match app-id="(?i)btop"
    match app-id="(?i)qview"
    match app-id="(?i)localsend"
    // 消息
    match app-id="(?i)wechat"
    match app-id="(?i)^qq$"
    match app-id="(?i)telegram"
    match app-id="(?i)discord"
    // 查词 / 便签
    // gnome-text-editor 的实际 Wayland app-id 是 org.gnome.TextEditor（不是连字符形式，
    // Text 与 Editor 之间也没有分隔符）——「gnome-text-editor」这条旧写法从未命中，
    // 便签一直按平铺打开。实测 id 后改为精确匹配。
    match app-id="(?i)eudic"
    match app-id=r#"(?i)org\.gnome\.TextEditor"#
    // Pot — 划词翻译与它的偏好面板。翻译窗与「Config」面板同属一个 app-id，
    // 都在本规则内，面板不再像原来那样另设一档尺寸（niri 会遵从面板自己请求的
    // 尺寸，只有它主动放弃首选尺寸时才会落到下面的浮窗默认值）。
    match app-id="(?i)pot"
    // 其它（邮件 / AI 模型选择器 / Anki / 音乐 / 代理 / 磁盘占用图）
    // ⚠ 这几个的 app-id 都不是照 .desktop 文件名写的 ——
    // thunderbird 的 Wayland app-id 是 "thunderbird"（不是 org.mozilla.Thunderbird，
    // .desktop 的 --name 只改 X11 的 WM_CLASS）、gapless 其实是 g4music
    // （com.github.neithern.g4music）。照文件名写会静默不命中
    // （gnome-text-editor 那条就是这么错的）。
    match app-id="(?i)thunderbird"
    match app-id="(?i)magpie"
    match app-id="(?i)anki"
    match app-id="(?i)g4music"
    // FlClash（代理客户端，取代 clash-verge）：app-id 来自上游
    // linux/CMakeLists.txt 的 APPLICATION_ID（com.follow.clash），
    // runner 里 g_set_prgname(APPLICATION_ID) 后作 Wayland app_id。
    match app-id="(?i)com.follow.clash"
    match app-id="(?i)disktree"
    // bilibili 桌面客户端（实测 app-id 就是 bilibili）
    match app-id="(?i)bilibili"

    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 623; }
}

// ═══════════════════════════════════════════════
// 微信 —— 拒掉客户端自带的全屏请求
// ═══════════════════════════════════════════════
//
// 2026-10-29 定因：微信一登录主窗口就铺满整屏（niri 里 tile = 2560×1440、
// is_floating = false），「朋友圈」窗口同样如此，与下面浮动窗口组的
// 0.50×0.60 预设不符 —— 全屏窗口只能待在 scrolling layout，会把
// open-floating + 尺寸预设整条盖掉。
//
// 客户端并没有真的要全屏，是 xwayland-satellite 判错了：微信在 X11 侧
// 请求 1920×1080（= DP-2 的物理尺寸），而 satellite 有一条启发式 ——
// 窗口尺寸与某块输出完全相等就当作全屏（日志原文：
// 「creating toplevel for Window { res_id: … } fullscreen: true」），
// 并在首个 commit 之前就发出 set_fullscreen。
//
// niri 侧的处理是「wants_fullscreen.is_some() && rules.open_fullscreen.is_none()」
// 即客户端要全屏而规则没表态就照单全收。open-fullscreen false 正是
// niri 文档给出的拦截开关：它在初始 configure 阶段生效，而 satellite
// 恰好在这个阶段就发了请求，所以拦得住。
//
// app-id 两个都写上：
//   - "wechat" —— 主窗口、朋友圈、公众号等可见窗口（实测 WM_CLASS 类名
//     均为 "wechat"，包括 Chromium 渲染的子窗口）；
//   - "WeChatAppEx" —— 微信自带的 RadiumWMPF 运行时窗口，目前只在
//     离屏渲染时出现（实测 540×540 → 1050×960，不成为 toplevel），
//     但它同样是 X11 客户端、同样可能被 satellite 判成全屏，一并挡住。
window-rule {
    match app-id="(?i)^wechat$"
    match app-id="(?i)^WeChatAppEx$"

    open-fullscreen false
}
