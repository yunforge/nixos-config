// 系统级快捷键：截图、会话、快捷键查看器
binds {
    // 截图 —— 走 Noctalia 自带截图：Mod+P 交互式区域截图，Mod+Ctrl+P 截整屏，
    // Mod+Shift+P 截当前窗口。三者都会先打开内置标注器，Done 后按
    // ~/.config/noctalia/config.toml 的 [shell.screenshot] 同时存盘
    // （~/Pictures/screenshots）并复制到剪贴板；标注器内 Ctrl+C 只复制、
    // Ctrl+S 只存盘。配置声明见 niri/noctalia.nix。
    //
    // 窗口截图走 `niri-screenshot-window` 而不是 `noctalia msg screenshot-window`：
    // Noctalia 的窗口截图要求 ext-image-copy-capture-v1，niri 26.04 未实现。
    // 脚本里先用 niri 截到临时文件，再交给 Noctalia 标注器，详见 niri/default.nix。
    Mod+P        hotkey-overlay-title="区域截图"  { spawn-sh "noctalia msg screenshot-region"; }
    Mod+Ctrl+P   hotkey-overlay-title="全屏截图"  { spawn-sh "noctalia msg screenshot-fullscreen"; }
    Mod+Shift+P  hotkey-overlay-title="窗口截图"  { spawn "niri-screenshot-window"; }

    // 退出
    Mod+Shift+E hotkey-overlay-title="退出 niri"        { quit; }
    // 关闭全部窗口（逐个走应用的关闭流程，等价于逐个点关闭按钮）
    Ctrl+Alt+Delete hotkey-overlay-title="关闭所有窗口" { spawn "niri-close-all"; }
    // 当某个应用请求 Niri 停止处理其键盘快捷键时，用来强制恢复或再次禁用 Niri 的快捷键处理
    Mod+Escape  hotkey-overlay-title="强制恢复/禁用niri快捷键" { toggle-keyboard-shortcuts-inhibit; }

    // 快捷键查看器
    Mod+Slash   hotkey-overlay-title="快捷键"           { spawn-sh "noctalia msg panel-toggle blackbartblues/keymap:panel"; }

    // 锁屏与会话
    // 命令名照 CLI schema 写：锁屏是 `session lock`，本版本没有 `screen-lock`
    // （名单：noctalia msg session --help）。写错会静默失败：spawn-sh 报错但没人看。
    Mod+Alt+L   hotkey-overlay-title="锁屏"             { spawn-sh "noctalia msg session lock"; }
    Mod+Alt+X   hotkey-overlay-title="会话菜单"         { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+Comma   hotkey-overlay-title="设置"             { spawn-sh "noctalia msg settings-toggle"; }
    Mod+S       hotkey-overlay-title="控制中心"         { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Alt+W   hotkey-overlay-title="壁纸切换"         { spawn-sh "noctalia msg panel-toggle wallpaper"; }
}
