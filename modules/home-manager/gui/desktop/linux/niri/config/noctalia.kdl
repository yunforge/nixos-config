layout {

    focus-ring {
        active-color   "#7287fd"
        inactive-color "#eff1f5"
        urgent-color   "#d20f39"
    }

    border {
        active-color   "#7287fd"
        inactive-color "#eff1f5"
        urgent-color   "#d20f39"
    }


    tab-indicator {
        active-color   "#7287fd"
        inactive-color "#bbc4f6"
        urgent-color   "#d20f39"
    }

    insert-hint {
        color "#7287fd80"
    }
}

recent-windows {
    highlight {
        active-color "#7287fd"
        urgent-color "#d20f39"
    }
}
