// ~/.config/niri/config.kdl — niri 主配置文件

// 核心配置：输入设备、自启程序、显示器
include "core/input.kdl"
include "core/startup.kdl"
// 与 niri-colors 同理：显示器配置按主机区分，无法放进被 symlink 的共享目录
include "~/.config/niri-outputs/outputs.kdl"

// 视觉效果：动画、模糊、磨砂玻璃、布局、光标、概览
include "visual/animations.kdl"
include "visual/blur.kdl"
include "visual/frosted-glass.kdl"
// layout.kdl：结构（间距、焦点环宽度、阴影参数…）由 HM 生成，窗口装饰**颜色**
// 由 Noctalia 写进 noctalia.kdl（见文件末尾）。niri 把两个 layout{} 段合并。
include "~/.config/niri-colors/layout.kdl"
include "visual/cursor.kdl"
// overview.kdl：概览底色，Noctalia 的 niri 模板不管这一项，仍由 HM 按亮/暗两态生成
include "~/.config/niri-colors/overview.kdl"

// 快捷键：系统、导航、应用
include "binds/system.kdl"
include "binds/navigation.kdl"
include "binds/apps.kdl"

// 窗口规则
include "windowrules.kdl"

// 隐藏客户端装饰
prefer-no-csd

// 截图保存位置：niri 自带的 screenshot 动作已不再绑定（截图统一走 babry，
// 见 binds/system.kdl），这条路径没有消费方，故删除。babry 的存盘走它自己的
// Ctrl+S 对话框，与 niri 无关。

// xwayland-satellite 集成
xwayland-satellite {
   on
   path "xwayland-satellite"
}

// Noctalia 渲染的窗口装饰颜色（焦点环 / 标签指示器 / 插入提示 / 最近窗口高亮）。
// 这是唯一由 Noctalia 负责的 niri 文件，**不进 git**（运行时产物，见 .gitignore）。
// optional=true 是必须的：文件首次生成前不存在，普通 include 会让整份配置加载失败
// （niri 对 include 既不 glob 也不容错），optional 只打一条 warn。
// Noctalia 的 niri/apply.sh 只用正则认这一行、不改写参数，故可安全地加 optional。
include "noctalia.kdl" optional=true
