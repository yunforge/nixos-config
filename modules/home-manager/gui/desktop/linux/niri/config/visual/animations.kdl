// 动画
// https://niri-wm.github.io/niri/Configuration%3A-Animations.html
//
// ── 时长语言（动效规范）──────────────
//   小元件（toast / 对话框）  ~130–170ms  落定快、几乎无回弹
//   窗口级（打开 / 关闭）      180–220ms   进入比离开略慢
//   空间级（工作区 / 概览）    ~170–230ms  大位移需要滑行让眼睛跟上
//   直接操控（拖拽 / 缩放）    跟手 1:1，松手后用弹簧吸收速度，不振荡
//
// 弹簧时长按 t ≈ 4/(ζ·√k) 估算（单位质量、近临界阻尼下的 98% 建立时间），
// 仅供相对比较；epsilon 也参与终止判定，绝对值以实际观感为准。
// 调参时在 animations 块里临时加 slowdown 0.4 放慢看轨迹。
//
// ⚠ custom-shader r"..." 是 KDL 的**原始字符串**，以第一个 ASCII 双引号结束。
//   所以 shader 内部（包括它里面的 // 注释）不能出现 ASCII 双引号——写一个就会
//   提前结束字符串，报错是 "found `收`, expected `;`" 这类看不出所以然的。写中文
//   注释时用括号或全角引号。（niri validate 会拦住，但报错点在字符串之后，难定位）

animations {
    // 关闭所有动画
    // off

    // 切换工作区动画
    //
    // 默认 k=1000 的建立时间 ≈126ms，4K 屏整列内容位移快得像"剪切"；
    // 降到 560 ≈169ms，给眼睛一点跟随的滑行，但仍配得上键盘触发的快操作。
    // ζ 保持 1.0：整列窗口是大表面，不回弹（Apple / HarmonyOS 同此）。
    workspace-switch {
        spring damping-ratio=1.0 stiffness=560 epsilon=0.0001
    }

    // 窗口打开动画 — 轻微放大 + 淡入（scale 0.96 → 1.0，macOS 的做法）
    //
    // 原先是"水面轻涟 + 凝聚成形"的自定义 shader（4 组方向波）。改成 scale+fade
    // 的理由是隐喻而不是性能：整套动画语言讲的是"ζ=1.0 不回弹、小元件 130–170ms、
    // 退场比入场快"，水波讲的是"液体被扰动"，是这套系统里唯一借来的第三种比喻；
    // 而平铺 WM 里开窗通常同时还会让相邻窗口重排，水波等于在一个本就很热闹的时刻
    // 再加一层注意。原来的代价其实不大（只在 220ms 内发生），所以这是取舍不是修 bug。
    //
    // 曲线仍是 ease-out-quart：起步极快、收尾干净，没有 ease-out-cubic 的拖尾。
    // 缩放取 0.96：幅度再大就读作"弹出"而不是"成形"。
    window-open {
        duration-ms 220
        curve "cubic-bezier" 0.16 1.0 0.3 1.0

        custom-shader r"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;

                // 以窗口中心为原点缩放
                float zoom = mix(0.96, 1.0, p);
                vec2 base = (coords_geo.xy - 0.5) / zoom + 0.5;

                vec3 coords_tex = niri_geo_to_tex * vec3(base, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);

                // 越界判据用 base 而不是 coords_geo：缩放过程中外圈会采样到纹理
                // 之外，判 coords_geo 会让那一圈拉伸边缘像素（GL_CLAMP_TO_EDGE），
                // 判 base 则正确地透明掉。
                if (base.x < 0.0 || base.x > 1.0 || base.y < 0.0 || base.y > 1.0) {
                    return vec4(0.0);
                }

                // 淡入在 55% 时长内完成：减少文字半透明的时间（原实现里的真细节，保留）
                return color * smoothstep(0.0, 0.55, p);
            }
        "
    }

    // 关闭窗口动画 — 淡出（退场比入场快）
    //
    // 两处 conventions 保留：
    //   时长  离开要比进入快（Apple/HarmonyOS 退场 ≈ 入场的 70–80%），180ms 对 220ms。
    //   缓动  离开用 ease-in（加速消失）。niri 无内置 ease-in 曲线，
    //         cubic-bezier(0.5,0,0.9,0.4) ≈ ease-in-quint。
    //
    // 删掉了原先叠在这里的三样：涟漪散开、向心塌陷（drain）、切向位移。
    // "退场的表现力应当交给淡出，位移只做余韵"这句原来就写在注释里 —— 现在才真的
    // 按它做（原来恰恰是位移在争主体）。
    window-close {
        duration-ms 180
        curve "cubic-bezier" 0.5 0.0 0.9 0.4

        custom-shader r"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;

                // 轻微缩小（1.0 → 0.98）表示收走；幅度刻意只有入场的一半
                float zoom = mix(1.0, 0.98, p);
                vec2 base = (coords_geo.xy - 0.5) / zoom + 0.5;

                vec3 coords_tex = niri_geo_to_tex * vec3(base, 1.0);
                vec4 color = texture2D(niri_tex, coords_tex.st);

                if (base.x < 0.0 || base.x > 1.0 || base.y < 0.0 || base.y > 1.0) {
                    return vec4(0.0);
                }

                return color * (1.0 - p);
            }
        "
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // 窗口移动动画
    //
    // 直接操控：跟手 1:1，松手后弹簧吸收惯性。ζ=1.0 不回弹是对的
    // （大表面回弹看起来像掉帧）。想拖拽更"紧"可把 stiffness 提到 1000。
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // 窗口大小调整动画
    //
    // 原来 ζ=0.7 是欠阻尼，缩放窗口时内容会弹两下。缩放是直接操控，
    // macOS / HarmonyOS 都是实时的、内容跟随重排、零回弹。
    // ζ 提到 1.0、stiffness 提到 1000 让几何紧紧咬住指针。
    // shader 是纯采样下一帧纹理、零畸变，本来就正确，保留。
    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001

        custom-shader r"
            vec4 resize_color(vec3 coords_curr_geo, vec3 size_curr_geo) {
                vec3 coords_tex_next = niri_geo_to_tex_next * coords_curr_geo;
                vec4 color = texture2D(niri_tex_next, coords_tex_next.st);
                return color;
            }
        "
    }

    // 通知的打开/关闭动画
    //
    // 原来 ζ=0.6 振荡明显。音量/亮度这类小元件，iOS 是滑入+淡入、
    // 一次温柔的落定，不回弹。ζ=0.9 k=1100 → ≈134ms。
    config-notification-open-close {
        spring damping-ratio=0.9 stiffness=1100 epsilon=0.001
    }

    // 对话框的打开/关闭动画
    //
    // 原来 ζ=0.6 k=500 ≈300ms 且带 1~2 次可见振荡——一个"确认退出"
    // 的严肃对话框在弹跳，气质不对。macOS 的 modal 是 ~220ms ease-out、
    // scale 0.96→1.0。ζ=0.9 k=700 → ≈168ms，落定快、几乎无回弹。
    exit-confirmation-open-close {
        spring damping-ratio=0.9 stiffness=700 epsilon=0.01
    }

    // 截图界面的打开（淡入）动画
    //
    // 注意：niri 自带的 screenshot 动作已于 2026-10-15 停用（截图统一走 babry，
    // 见 binds/system.kdl），所以这条**目前没有触发方**。留着只为万一再启用
    // niri 截图时不必重新调参；确认不再启用后可以删掉。
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-expo"
    }

    // 概览的打开/关闭缩放动画
    //
    // 原来 k=800 建立时间 ≈141ms，配合 zoom 0.40 的大缩放，
    // 概览"啪"地一下到位，像切换而非展开。iOS 应用库 / HarmonyOS
    // 多任务的同类展开是 350–420ms ease-in-out。
    // 临界阻尼弹簧天然是"两端慢中间快"，等价 ease-in-out，
    // 所以只降刚度即可：k=300 → ≈230ms。
    // zoom 一并从 0.40 提到 0.50（见 modules/home-manager/gui/wm/default.nix
    // 生成的 overview.kdl）：缩略图文字恢复可读，信息量不再损失。
    overview-open-close {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
    }

    // 最近窗口切换器的关闭淡出动画
    recent-windows-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }
}
