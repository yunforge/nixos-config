// ============================================================
// 磨砂玻璃桌面 — 统一窗口规则（niri v26.04）
// ============================================================
//
// Noctalia Shell 的界面元素（启动器、控制中心、overview）使用 layer-shell，
// window-rule 对 layer-shell 无效，必须用 layer-rule 启用模糊。
// xray：让窗口背景透过下面的其它窗口层


// 全局：所有窗口声明启用模糊。
// 注意这本身不产生任何视觉效果——不透明窗口没有东西可以"透"。
// 实际生效的只有下面显式给了 opacity < 1 的窗口（ghostty / btop），
// 以及 Noctalia 的 layer 面（layer-rule 对本段 window-rule 无效，需单独声明）。
// 保留这条规则的意义：以后新增的半透明窗口不必重复声明 blur/xray。
window-rule {
    background-effect {
        blur true
        xray false
    }
}

// --- 终端模拟器：磨砂玻璃的黄金场景 ---
// btop 窗口由 ghostty 以 --class=btop 启动（见 binds/apps.kdl），单独列出
//
// opacity 取 0.80：这是「玻璃好看」与「文字可读」的取舍，而它是可量化的。opacity 作用在
// **整个窗口**上（niri 文档：“applied to every surface of the window”），所以窗口背后永远
// 是“0.8×底色 + 0.2×模糊后的壁纸”。ghostty / btop 的底色是 Frappe base #303446，主文字是
// Frappe text #C6D0F5；取**当前壁纸**最亮 5% 区域（模糊 + saturation 1.10 只会更亮，即
// 最坏情况）实测 #DFD0CD，据此算：
//
//     opacity   合成后的底色   对比度      判定
//       0.85    #4A4B5A       5.59:1   ✅
//       0.80    #535361       4.94:1   ✅ ← 取这个
//       0.75    #5C5B68       4.37:1   ⚠️ 低于 AA(4.5)
//
// 为什么不让 ghostty 自己只压背景（它确实能让文字保持不透明）：量过，暗区背后
// 0.8×#303446 = #2A2E3F，与纯 #303446 几乎无差 —— 玻璃“显形”靠的是文字连同底色一起透到
// 壁纸上，只透明背景就没效果了。另外 niri 的 opacity 对已开着的窗口即时生效，应用自己的
// 背景透明度得重开才生效。完整取舍见 docs/themes.md。
//
// 门槛**取决于壁纸**：上面是当前那张高调（亮）壁纸的数字；纯白壁纸下 0.80 会掉到 4.29
// （差一点），而换成暗调壁纸时 0.70 乃至 0.65 都还很安全、玻璃感明显得多——想要“一眼看得出
// 是玻璃”，正确做法是配暗壁纸（见 docs/themes.md 的壁纸一节与选图准则）。
window-rule {
    match app-id=r#"^(ghostty|com\.mitchellh\.ghostty|btop)$"#
    opacity 0.80
    background-effect {
        blur true
        xray true
    }
}

// --- Thunderbird（LiquidBird 主题）：菜单/提示的模糊 ---
// 主题把 TB 的 chrome 做成半透明（见 modules/home-manager/gui/apps/productivity.nix），
// 窗口本体已被上面的全局规则盖住；但弹层不继承窗口规则的 background-effect，
// 不单独声明就是一块不带模糊的透明方块。
// 半径原来取 18 的那条依据（TB 自己的 XUL 菜单圆角，见上游 integration/niri.kdl）
// 大于当前窗口圆角 8，内层会显得比外层圆，故降到 8 与窗口同档。另注：Gecko 部分
// 菜单走 wl-subsurface（如 Firefox），那些不是 xdg-popup，本块管不到 ——
// 属上游规则边界，不是配置遗漏。
window-rule {
    match app-id=r#"^org\.mozilla\.Thunderbird$"#
    popups {
        geometry-corner-radius 8
        background-effect {
            blur true
            xray false
        }
    }
}

// 模糊概览壁纸
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

/*
  Noctalia（夜境）
  为所有界面图层禁用透视效果，让视觉效果更贴合真实观感。
  当系统支持 ext-background-effects 协议时，Noctalia 会自动推送模糊区域数据。
*/
layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
    // blur false
  }
}
