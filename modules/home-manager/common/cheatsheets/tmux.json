{
  "title": "Tmux 快捷键 (Prefix = Ctrl+B)",
  "provider": "tmux",
  "binds": {
    "会话": [
      {
        "key": "Prefix + C",
        "desc": "新建会话",
        "action": " "
      },
      {
        "key": "Prefix + R",
        "desc": "重命名会话",
        "action": " "
      },
      {
        "key": "Prefix + K",
        "desc": "关闭会话",
        "action": " "
      },
      {
        "key": "Prefix + P",
        "desc": "上一个会话",
        "action": " "
      },
      {
        "key": "Prefix + N",
        "desc": "下一个会话",
        "action": " "
      },
      {
        "key": "Alt + Up",
        "desc": "上一个会话",
        "action": " "
      },
      {
        "key": "Alt + Down",
        "desc": "下一个会话",
        "action": " "
      },
      {
        "key": "Prefix + d",
        "desc": "分离当前会话",
        "action": " "
      }
    ],
    "窗口": [
      {
        "key": "Prefix + c",
        "desc": "新建窗口",
        "action": " "
      },
      {
        "key": "Prefix + r",
        "desc": "重命名窗口",
        "action": " "
      },
      {
        "key": "Prefix + k",
        "desc": "关闭窗口",
        "action": " "
      },
      {
        "key": "Alt + 1..9",
        "desc": "切换到第 N 个窗口",
        "action": " "
      },
      {
        "key": "Alt + Left",
        "desc": "上一个窗口",
        "action": " "
      },
      {
        "key": "Alt + Right",
        "desc": "下一个窗口",
        "action": " "
      },
      {
        "key": "Alt + Shift + Left",
        "desc": "向左移动窗口",
        "action": " "
      },
      {
        "key": "Alt + Shift + Right",
        "desc": "向右移动窗口",
        "action": " "
      }
    ],
    "面板": [
      {
        "key": "Prefix + h",
        "desc": "上下分割",
        "subcat": "分割",
        "action": " "
      },
      {
        "key": "Prefix + v",
        "desc": "左右分割",
        "subcat": "分割",
        "action": " "
      },
      {
        "key": "Alt + Enter",
        "desc": "上下分割",
        "subcat": "分割",
        "action": " "
      },
      {
        "key": "Alt + Shift + Enter",
        "desc": "左右分割",
        "subcat": "分割",
        "action": " "
      },
      {
        "key": "Prefix + x",
        "desc": "关闭面板",
        "subcat": "管理",
        "action": " "
      },
      {
        "key": "Alt + Escape",
        "desc": "关闭面板",
        "subcat": "管理",
        "action": " "
      },
      {
        "key": "Ctrl + Alt + Left",
        "desc": "选择左侧面板",
        "subcat": "导航",
        "action": " "
      },
      {
        "key": "Ctrl + Alt + Right",
        "desc": "选择右侧面板",
        "subcat": "导航",
        "action": " "
      },
      {
        "key": "Ctrl + Alt + Up",
        "desc": "选择上方面板",
        "subcat": "导航",
        "action": " "
      },
      {
        "key": "Ctrl + Alt + Down",
        "desc": "选择下方面板",
        "subcat": "导航",
        "action": " "
      },
      {
        "key": "Ctrl + Alt + Shift + Left",
        "desc": "向左调整大小",
        "subcat": "调整大小",
        "action": " "
      },
      {
        "key": "Ctrl + Alt + Shift + Right",
        "desc": "向右调整大小",
        "subcat": "调整大小",
        "action": " "
      },
      {
        "key": "Ctrl + Alt + Shift + Up",
        "desc": "向上调整大小",
        "subcat": "调整大小",
        "action": " "
      },
      {
        "key": "Ctrl + Alt + Shift + Down",
        "desc": "向下调整大小",
        "subcat": "调整大小",
        "action": " "
      },
      {
        "key": "Prefix + z",
        "desc": "最大化/还原面板",
        "subcat": "管理",
        "action": " "
      }
    ],
    "复制模式": [
      {
        "key": "Prefix + [",
        "desc": "进入复制模式",
        "action": " "
      },
      {
        "key": "v",
        "desc": "开始选择",
        "action": " "
      },
      {
        "key": "y",
        "desc": "复制并退出",
        "action": " "
      }
    ],
    "其他": [
      {
        "key": "Prefix + q",
        "desc": "重载配置",
        "action": " "
      },
      {
        "key": "Prefix + ?",
        "desc": "弹出全部快捷键列表",
        "action": " "
      }
    ]
  }
}
