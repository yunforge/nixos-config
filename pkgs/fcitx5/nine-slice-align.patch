--- a/src/ui/classic/inputwindow.cpp
+++ b/src/ui/classic/inputwindow.cpp
@@ -511,6 +511,16 @@
 
     auto width = static_cast<unsigned int>(yogaWidth);
     auto height = static_cast<unsigned int>(yogaHeight);
+
+    // The nine-slice background is cut at (width - marginRight) and
+    // (height - marginBottom). Those far cuts land on half device pixels
+    // whenever the window size is odd under a fractional buffer scale, and
+    // cairo then blends a translucent column into every cut line. Aligning the
+    // window to 4 logical pixels keeps all cuts (and the buffer size at 1.5x
+    // and 2x) on whole device pixels.
+    constexpr unsigned int kSizeAlign = 4;
+    width = (width + kSizeAlign - 1) & ~(kSizeAlign - 1);
+    height = (height + kSizeAlign - 1) & ~(kSizeAlign - 1);
     return {width, height};
 }
 
