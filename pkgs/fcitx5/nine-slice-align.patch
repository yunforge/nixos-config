--- a/src/ui/classic/inputwindow.cpp
+++ b/src/ui/classic/inputwindow.cpp
@@ -511,6 +511,21 @@
 
     auto width = static_cast<unsigned int>(yogaWidth);
     auto height = static_cast<unsigned int>(yogaHeight);
+
+    // There is a known 1-device-pixel transparent slot along the *vertical*
+    // nine-slice cut of the input panel background under fractional scaling
+    // (niri at 1.5x: card white measures 217, that column 177-181 because it
+    // shows the window behind the panel; the horizontal cut is clean).
+    // paintTile() already snaps every grid line to whole device pixels, and a
+    // standalone cairo replica of make_tiles/paintRegion/paintTile with the
+    // real theme art paints that column solid white -> the cause is NOT
+    // margin or size parity, and this alignment is therefore NOT a proven
+    // fix. It does keep the size round trip exact (resize() rounds
+    // logical -> device while repaint() divides back: 133 -> 200 -> 133.3333),
+    // which is worth keeping; open question tracked in fcitx5 issue 1712.
+    constexpr unsigned int kSizeAlign = 4;
+    width = (width + kSizeAlign - 1) & ~(kSizeAlign - 1);
+    height = (height + kSizeAlign - 1) & ~(kSizeAlign - 1);
     return {width, height};
 }
 
