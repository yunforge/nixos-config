     const double scaleY =
         static_cast<double>(targetResizeHeight) / resizeHeight;
 
+    /*
+     * GTK records this paint into a cairo recording surface and replays it with
+     * the output scale applied (gtk_snapshot_append_cairo), so the device scale
+     * cannot be observed here. When a nine-slice cut line lands on a fractional
+     * device pixel, the two tiles that share it can each cover only part of
+     * that device column; the column then stays under-covered and shows through
+     * as a one pixel vertical line. Overlapping neighbouring tiles by one
+     * logical pixel along their shared cut lines keeps the column fully covered
+     * whatever scale the recording is replayed with, and CAIRO_EXTEND_PAD keeps
+     * the overlap from pulling in neighbouring tile content.
+     */
+    constexpr double kTileOverlap = 1.0;
+    const double overlapX = kTileOverlap / (scaleX > 0 ? scaleX : 1.0);
+    const double overlapY = kTileOverlap / (scaleY > 0 ? scaleY : 1.0);
+
